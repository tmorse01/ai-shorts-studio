// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildRenderGraph > snapshots the graph for a crossfade with framing and fades 1`] = `"color=c=black:s=1080x1920:r=30:d=8,format=rgba[base0];[0:v]trim=start=0:duration=4.2,setpts=PTS-STARTPTS+0/TB,format=rgba,scale=1080:1920[vl0];[base0][vl0]overlay=x=540-w/2:y=960-h/2:eof_action=pass:enable='between(t,0,4.2)'[vc0];[1:v]trim=start=0.8:duration=4.2,setpts=PTS-STARTPTS+3.8/TB,format=rgba,split=2[vl1fgsrc][vl1bgsrc];[vl1bgsrc]scale=1240:2080,gblur=sigma=40,colorchannelmixer=rr=0.65:gg=0.65:bb=0.65,crop=1080:1920[vl1bg];[vl1fgsrc]scale=1080:1920[vl1fg];[vl1bg][vl1fg]overlay=x=540-w/2:y=960-h/2[vl1pre];[vl1pre]fade=t=in:st=3.8:d=0.4:alpha=1[vl1];[vc0][vl1]overlay=x=0:y=0:eof_action=pass:enable='between(t,3.8,8)'[vc1];[vc1]format=yuv420p,fps=30[vout];[0:a]atrim=start=0:duration=4.2,asetpts=PTS-STARTPTS+0/TB,afade=t=in:st=0:d=0.3,afade=t=out:st=3.8:d=0.4[al0];[1:a]atrim=start=0.8:duration=4.2,asetpts=PTS-STARTPTS+3.8/TB,volume=0.8,afade=t=in:st=3.8:d=0.4,adelay=delays=3800:all=1[al1];[al0][al1]amix=inputs=2:duration=longest:normalize=0[aout]"`;

exports[`buildRenderGraph > snapshots the graph for a dip with ducked music 1`] = `"color=c=black:s=1080x1920:r=30:d=6,format=rgba[base0];[0:v]trim=start=0:duration=3.25,setpts=PTS-STARTPTS+0/TB,format=rgba,scale=1080:1920,fade=t=out:st=2.75:d=0.25:alpha=1[vl0];[base0][vl0]overlay=x=540-w/2:y=960-h/2:eof_action=pass:enable='between(t,0,3.25)'[vc0];[1:v]trim=start=0.25:duration=3.25,setpts=PTS-STARTPTS+2.75/TB,format=rgba,scale=1080:1920,fade=t=in:st=3:d=0.25:alpha=1[vl1];[vc0][vl1]overlay=x=540-w/2:y=960-h/2:eof_action=pass:enable='between(t,2.75,6)'[vc1];[vc1]format=yuv420p,fps=30[vout];[0:a]atrim=start=0:duration=3.25,asetpts=PTS-STARTPTS+0/TB,afade=t=out:st=2.75:d=0.25[al0];[1:a]atrim=start=0.25:duration=3.25,asetpts=PTS-STARTPTS+2.75/TB,afade=t=in:st=3:d=0.25,adelay=delays=2750:all=1[al1];[2:a]atrim=start=0:duration=2,asetpts=PTS-STARTPTS+0.5/TB,adelay=delays=500:all=1[al2];[3:a]atrim=start=0:duration=6,asetpts=PTS-STARTPTS+0/TB,volume=0.5,afade=t=out:st=5:d=1,volume=volume='if(lt(t,0.5),if(gte(t,0.42),(1+(-0.748811)*(t-0.42)/0.08),1),if(lt(t,2.5),if(gte(t,0.5),(0.251189+(0)*(t-0.5)/2),1),if(lt(t,2.9),if(gte(t,2.5),(0.251189+(0.748811)*(t-2.5)/0.4),1),1)))':eval=frame[al3];[al0][al1][al2][al3]amix=inputs=4:duration=longest:normalize=0[aout]"`;

exports[`buildRenderGraph > snapshots the graph for a single clip 1`] = `"color=c=black:s=1080x1920:r=30:d=4,format=rgba[base0];[0:v]trim=start=1:duration=4,setpts=PTS-STARTPTS+0/TB,format=rgba,scale=1080:1920[vl0];[base0][vl0]overlay=x=540-w/2:y=960-h/2:eof_action=pass:enable='between(t,0,4)'[vc0];[vc0]format=yuv420p,fps=30[vout];[0:a]atrim=start=1:duration=4,asetpts=PTS-STARTPTS+0/TB[al0];[al0]anull[aout]"`;
